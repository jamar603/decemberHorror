{
  "name": "december",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/write-version.mjs && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --external:uWebSockets.js --outfile=dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "bridge": "node tools/dev-bridge.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.170.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.51.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "playwright-core": "^1.58.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "ws": "^8.18.0"
  }
}
